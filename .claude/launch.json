{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pair-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      "name": "pair-backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "backend\\gradlew.bat", "-p", "backend", "bootRun", "--console=plain"],
      "port": 8180,
      "autoPort": false
    },
    {
      "name": "cam-proctor",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "cam-proctor", "run", "dev"],
      "port": 5174,
      "url": "https://localhost:5174"
    },
    {
      "name": "cam-proctor-http",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "cam-proctor", "run", "dev", "--", "--mode", "http"],
      "port": 5174
    }
  ]
}

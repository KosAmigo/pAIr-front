{
  "name": "pair-front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode lan",
    "dev:lan": "vite --mode lan",
    "dev:local": "vite",
    "dev:all": "node ../scripts/dev-all.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:auth": "node --experimental-strip-types --test tests/auth/*.test.mjs",
    "test:credits": "node --experimental-strip-types --test tests/credits.test.mjs tests/credit-payments.test.mjs",
    "test:task-gen": "node --experimental-strip-types --test tests/task-gen.test.mjs tests/task-board.test.mjs",
    "test:review": "node --experimental-strip-types --test tests/review-tree.test.mjs tests/score-steps.test.mjs tests/habits.test.mjs",
    "test:replay": "node --experimental-strip-types --test tests/replay-*.test.mjs",
    "test:live-diagnostics": "node --experimental-strip-types --test tests/live-diagnostics.test.mjs",
    "test:chat-attach": "node --experimental-strip-types --test tests/chat-attach.test.mjs",
    "test:anti-cheating": "node --experimental-strip-types --test tests/anti-cheating.test.mjs",
    "test:proctor": "node --experimental-strip-types --test tests/proctor/*.test.ts",
    "test:scripts": "node --test tests/dev-all.test.mjs",
    "preview": "vite preview",
    "e2e": "playwright test",
    "shots": "playwright test --grep @shot",
    "test:questions": "node --experimental-strip-types --test tests/questions.test.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@lezer/highlight": "^1.2.5",
    "@mediapipe/tasks-vision": "1.2.3",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.71.0",
    "motion": "^14.14.0",
    "pretendard": "^1.3.9",
    "qrcode": "1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.187.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "ws": "8.23.0"
  }
}

# 의존성, 빌드 결과
node_modules/
dist/
dist-ssr/
build/
out/

# 환경 변수, 비밀 값 (API 키는 절대 커밋하지 않는다)
.env
.env.*
!.env.example
*.local

# Claude Code 개인 설정
.claude/settings.local.json

# 로그
logs/
*.log
npm-debug.log*
# 단, 과제 자료와 채점 샘플 안의 로그는 응시자가 보는 과제 파일이라 올린다
!backend/src/main/resources/tasks/**/logs/
!backend/src/main/resources/tasks/**/*.log
!grader/samples/**/logs/
!grader/samples/**/*.log

# 파일럿 응시 기록과 채점 원본 데이터 (개인 정보가 들어갈 수 있음)
pilot-data/

# Office 임시 잠금 파일
~$*

# OS, 편집기
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# Java / Gradle / IntelliJ
backend/.gradle/
backend/build/
.idea/
*.iml

# 외부 스킬 도구 폴더 (.claude/skills/ 는 팀이 같이 쓰도록 저장소에 올린다)
.agents/
skills-lock.json
# ui-ux-pro-max 는 .agents/ 를 가리키는 이 PC 전용 링크라 올리지 않는다 (각자 설치)
.claude/skills/ui-ux-pro-max
